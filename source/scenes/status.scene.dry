Q.internal_dissent = Math.max(0, 100 - Q.party_unity);

if (Q.party_unity >= 75) {
    Q.internal_dissent_label = 'very low';
} else if (Q.party_unity >= 60) {
    Q.internal_dissent_label = 'low';
} else if (Q.party_unity >= 45) {
    Q.internal_dissent_label = 'moderate';
} else if (Q.party_unity >= 30) {
    Q.internal_dissent_label = 'high';
} else {
    Q.internal_dissent_label = 'very high';
}
